---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Explainer from '../components/Explainer.astro';
import Ribbon from '../components/Ribbon.astro';
import FiveAm from '../components/FiveAm.astro';
import Streak from '../components/Streak.astro';
import Marquee from '../components/Marquee.astro';
import Steps from '../components/Steps.astro';
import Score from '../components/Score.astro';
import Features from '../components/Features.astro';
import Stats from '../components/Stats.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---
<Layout>
  <Nav />
  <main id="top">
    <Hero />
    <Explainer />
    <Ribbon />
    <FiveAm />
    <Marquee />
    <Steps />
    <Streak />
    <Score />
    <Features />
    <Stats />
    <Faq />
    <Cta />
  </main>
  <Footer />
</Layout>

<script>
  import { initScroll } from '../scripts/scroll';

  // Initialize scroll engine and hero animations immediately
  initScroll();

  /* Smooth anchor scrolling */
  document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
    a.addEventListener('click', (e) => {
      const id = a.getAttribute('href');
      if (!id || id.length < 2) return;
      const el = document.querySelector(id);
      if (!el) return;
      e.preventDefault();
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 40, behavior: 'smooth' });
    });
  });
</script>
