---
import Layout from '../layouts/Layout.astro';
import { meta } from '../data/site';

const updated = 'August 2026';
const title = 'Privacy Policy — HudJee';
const description =
  'How HudJee collects, uses and stores the information you give us when you join the waitlist.';
---
<Layout title={title} description={description}>
  <main class="doc">
    <div class="wrap">
      <a class="back" href="/">← Back to HudJee</a>
      <h1>Privacy Policy</h1>
      <p class="updated">Last updated {updated}</p>

      <p class="lede">
        HudJee is a study app. The short version: we collect your name, email and
        batch so we can send you a beta invite. We do not sell it, and we do not
        share it with coaching institutes.
      </p>

      <h2>What we collect</h2>
      <p>When you join the waitlist we store the name, email address and batch
        you enter in the form, along with the date you signed up. That is the
        entire set. We do not ask for a phone number, an address, or payment
        details at this stage.</p>

      <h2>Why we collect it</h2>
      <p>Three reasons, and no others. To send you a beta invite when your batch
        comes up. To email you occasional product updates about HudJee. To count
        how many people are waiting, which is the number shown on the home page.</p>

      <h2>Who can see it</h2>
      <p>Waitlist entries are stored in Supabase, our database provider, on
        servers in the Asia-Pacific region. Only the HudJee team can read them.
        We do not sell, rent or trade your details, and we do not pass them to
        coaching institutes, tutors or advertisers.</p>

      <h2>Analytics and cookies</h2>
      <p>This waitlist page sets no advertising cookies and runs no third-party
        tracking pixels. Fonts are loaded from Google Fonts, which means Google
        receives your IP address as part of that request — a standard consequence
        of loading a web font.</p>

      <h2>How long we keep it</h2>
      <p>Until you ask us to delete it, or until the beta closes and you have not
        taken up an invite, whichever comes first.</p>

      <h2>Your choices</h2>
      <p>Email <a href={`mailto:${meta.org.email}`}>{meta.org.email}</a> and ask
        us to show you what we hold, correct it, or delete it. We will action
        deletion requests within 30 days. Every product email we send carries an
        unsubscribe link.</p>

      <h2>Children</h2>
      <p>HudJee is built for students preparing for the JEE, many of whom are
        under 18. If you are under 18, please join with a parent or guardian's
        knowledge. We collect no more from a minor than from anyone else, and a
        parent or guardian may email us to have a record removed.</p>

      <h2>Changes</h2>
      <p>If this policy changes in a way that affects what we do with your data,
        we will email everyone on the waitlist before the change takes effect.</p>

      <h2>Contact</h2>
      <p><a href={`mailto:${meta.org.email}`}>{meta.org.email}</a></p>
    </div>
  </main>
</Layout>

<style>
  .doc{
    padding:clamp(80px,10vw,140px) 0 120px;
    color:var(--app-text-2);
    font-size:17px;line-height:1.75;
  }
  .wrap{max-width:720px;margin:0 auto;padding:0 24px;}
  .back{
    display:inline-block;margin-bottom:48px;
    color:var(--app-text-3);text-decoration:none;font-size:15px;
  }
  .back:hover{color:var(--app-text-2);}
  h1{
    font-size:clamp(36px,6vw,52px);line-height:1.1;
    color:var(--app-text);margin:0 0 12px;
  }
  .updated{color:var(--app-text-3);font-size:15px;margin:0 0 40px;}
  .lede{
    font-size:19px;color:var(--app-text-2);
    padding:24px;border-radius:var(--app-r-card);
    background:var(--app-card);border:1px solid var(--app-card-border);
    margin:0 0 48px;
  }
  h2{
    font-size:22px;color:var(--app-text);
    margin:44px 0 12px;line-height:1.3;
  }
  p{margin:0 0 16px;}
  a{color:var(--app-purple);}
</style>
