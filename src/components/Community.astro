---
import { community } from '../data/site';

/**
 * ────────────────────────────────────────────────────────────────
 *  Community — one outlined hero panel over three link tiles.
 *
 *  The glyphs are filled and gradient-ramped rather than the 2px line
 *  icons in Icon.astro: that component's contract is the DS line spec,
 *  and brand marks don't survive being redrawn as strokes.
 *
 *  They also run the house inks instead of each service's own brand
 *  colour — an accurate Instagram magenta, YouTube red and WhatsApp
 *  green next to each other would pull the whole strip off-palette.
 * ────────────────────────────────────────────────────────────────
 */
const GLYPHS: Record<string, string> = {
  instagram: `<svg viewBox="0 0 24 24" fill="none">
    <rect x="2.6" y="2.6" width="18.8" height="18.8" rx="5.6" stroke="url(#cmA)" stroke-width="2.3"/>
    <circle cx="12" cy="12" r="4.3" stroke="url(#cmA)" stroke-width="2.3"/>
    <circle cx="17.5" cy="6.6" r="1.5" fill="url(#cmA)"/></svg>`,
  youtube: `<svg viewBox="0 0 24 24">
    <rect x="1.8" y="4.8" width="20.4" height="14.4" rx="4.6" fill="url(#cmB)"/>
    <path d="M10.1 9.1v5.8l5.1-2.9z" fill="#0A0A0C"/></svg>`,
  whatsapp: `<svg viewBox="0 0 24 24">
    <path d="M12 2.4a9.5 9.5 0 0 0-8.1 14.4l-1.3 4.8 5-1.3A9.5 9.5 0 1 0 12 2.4Z" fill="url(#cmC)"/>
    <path d="M9 7.7c.2-.5.4-.5.7-.5h.6c.2 0 .5 0 .7.5l.9 2c.1.2.1.4 0 .6l-.5.7c-.1.2-.2.3 0 .6.7 1.1 1.5 1.7 2.6 2.2.3.1.4.1.6-.1l.7-.8c.2-.2.3-.2.6-.1l1.8 1c.3.1.4.3.4.5 0 .8-.6 1.6-1.3 1.8-.8.2-1.9.1-3.9-.9-2.3-1.1-3.8-3.4-4-4.4-.2-1.1.1-2.2.4-2.6Z" fill="#0A0A0C"/></svg>`,
};

/* Same pennant as the FAQ rows, blown up as the panel's mark. */
const pennant = `<svg viewBox="0 0 26 34" fill="none" aria-hidden="true">
  <path d="M1 4a3 3 0 0 1 3-3h18a3 3 0 0 1 3 3v29l-12-8.5L1 33V4Z" fill="url(#cmD)"/>
</svg>`;
---
<section class="pad" id="community">
  <div class="wrap">
    <div class="panel rv">
      <div class="panel-copy">
        <p class="eyebrow">{community.panel.eyebrow}</p>
        <h2>{community.panel.title}</h2>
        <p class="lede">{community.panel.body}</p>
        <a class="join btn-wipe" href={community.panel.cta.href}>{community.panel.cta.label}</a>
      </div>

      <div class="panel-art" aria-hidden="true">
        <span class="pennant"><Fragment set:html={pennant} /></span>
      </div>
    </div>

    <div class="tiles">
      {community.cards.map((c, i) => (
        <a class="tile rv" href={c.href} style={`transition-delay:${i * 0.05}s`}>
          <span class="tile-ico"><Fragment set:html={GLYPHS[c.icon]} /></span>
          <span class="tile-foot">
            <span class="tile-eyebrow">{c.eyebrow}</span>
            <span class="tile-title">{c.title}</span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <svg class="cm-sprite" aria-hidden="true" focusable="false">
    <defs>
      {/* userSpaceOnUse over the 24-unit viewBox: the Instagram mark is
          three separate pieces and would otherwise get three ramps. */}
      <linearGradient id="cmA" gradientUnits="userSpaceOnUse" x1="2" y1="22" x2="22" y2="2">
        <stop offset="0%" stop-color="#E86FB8"/><stop offset="100%" stop-color="#FFD6F0"/>
      </linearGradient>
      <linearGradient id="cmB" gradientUnits="userSpaceOnUse" x1="2" y1="19" x2="22" y2="5">
        <stop offset="0%" stop-color="#F2963C"/><stop offset="100%" stop-color="#FFE2C4"/>
      </linearGradient>
      <linearGradient id="cmC" gradientUnits="userSpaceOnUse" x1="2" y1="22" x2="22" y2="2">
        <stop offset="0%" stop-color="#7B5CF0"/><stop offset="100%" stop-color="#E7DDFF"/>
      </linearGradient>
      <linearGradient id="cmD" gradientUnits="userSpaceOnUse" x1="1" y1="33" x2="25" y2="1">
        <stop offset="0%" stop-color="#7B5CF0"/>
        <stop offset="55%" stop-color="#C9A8FF"/>
        <stop offset="100%" stop-color="#F0CBA6"/>
      </linearGradient>
    </defs>
  </svg>
</section>

<style>
  .cm-sprite{position:absolute;width:0;height:0;}

  /* ── Hero panel ──────────────────────────────────────────────────
     Gradient stroke on a transparent fill, the same two-layer
     background the primary button uses — it's the only way to put a
     gradient on a border in CSS. */
  .panel{
    display:grid;grid-template-columns:1fr auto;align-items:center;gap:var(--space-6);
    border:1.5px solid transparent;border-radius:28px;
    /* The light end of the ramp, not --app-grad: that gradient starts at
       #7B68E8, which is barely a step off the page at 1.5px. */
    background:
      linear-gradient(var(--app-bg),var(--app-bg)) padding-box,
      linear-gradient(115deg,#A99BF2,#E86FB8 45%,#F2963C) border-box;
    padding:clamp(28px,3.4vw,48px);
  }
  .panel-copy{max-width:560px;}
  .panel h2{font-size:clamp(28px,3.6vw,44px);margin-bottom:var(--space-4);}
  .panel .lede{margin-bottom:var(--space-6);}

  /* Sizing only — the fill, outline and hover wipe come from .btn-wipe
     in global.css. Anything set here would beat it: Astro scopes this
     rule with an attribute selector, so it outranks the global class. */
  .join{
    display:inline-flex;align-items:center;justify-content:center;
    font-family:var(--font-display);font-weight:var(--fw-extrabold);font-size:16px;
    padding:15px 28px;
  }

  /* Dotted field behind the mark, painted as a background rather than
     ~40 elements. */
  .panel-art{
    width:clamp(150px,17vw,230px);height:clamp(150px,17vw,230px);
    display:grid;place-items:center;
    color:#3D3B47;
    background-image:radial-gradient(currentColor 1.7px, transparent 1.8px);
    background-size:26px 26px;
  }
  .pennant{display:block;width:44%;}
  .pennant :global(svg){width:100%;height:auto;display:block;
    filter:drop-shadow(0 14px 26px rgba(0,0,0,.55));}

  /* ── Link tiles ──────────────────────────────────────────────── */
  .tiles{
    display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-4);
    margin-top:var(--space-6);
  }
  .tile{
    display:flex;flex-direction:column;justify-content:space-between;
    min-height:190px;padding:22px 24px 24px;
    border:1px solid var(--app-card-border);border-radius:22px;
    transition:border-color .18s,background .18s,transform .18s cubic-bezier(.2,1.3,.4,1);
  }
  .tile:hover{border-color:#403E4A;background:#131218;transform:translateY(-4px);}
  .tile:focus-visible{outline:2px solid var(--app-purple);outline-offset:3px;}
  .tile-ico{align-self:flex-end;width:38px;height:38px;}
  .tile-ico :global(svg){width:100%;height:100%;display:block;}
  .tile-eyebrow{
    display:block;color:var(--app-text-3);font-size:13px;
    font-weight:var(--fw-bold);margin-bottom:6px;
  }
  .tile-title{
    display:block;font-family:var(--font-display);font-weight:var(--fw-black);
    font-size:clamp(20px,2.1vw,28px);line-height:1.1;letter-spacing:-.4px;
  }

  @media (max-width:860px){
    .panel{grid-template-columns:1fr;}
    /* The dotted field is filler at this width — it would push the copy
       into a column barely wider than the mark itself. */
    .panel-art{display:none;}
    .tiles{grid-template-columns:1fr;}
    .tile{min-height:0;}
  }
</style>
