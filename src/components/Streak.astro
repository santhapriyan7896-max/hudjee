---
import { streak as s } from '../data/site';
const days = Array.from({ length: s.totalDays }, (_, i) => i);

/* Shapes that drift around the calendar. `at` is left/top as a percentage
   of the pinned screen, `speed` how fast it lifts against the scroll and
   `spin` how far it turns over the section. Keep them clear of the middle
   — the card sits there. */
const DECOR = [
  { shape: 'pinwheel', left: '7%',  top: '17%', size: 112, speed: 0.9,  spin: 40,  rot: -8 },
  { shape: 'asterisk', left: '88%', top: '13%', size: 78,  speed: 1.3,  spin: -60, rot: 0 },
  { shape: 'crescent', left: '4%',  top: '64%', size: 96,  speed: 0.55, spin: 34,  rot: 12 },
  { shape: 'arch',     left: '90%', top: '60%', size: 118, speed: 1.05, spin: -26, rot: -6 },
  { shape: 'diamond',  left: '17%', top: '87%', size: 62,  speed: 1.45, spin: 70,  rot: 0 },
  { shape: 'squiggle', left: '80%', top: '86%', size: 74,  speed: 0.75, spin: -34, rot: 10 },
  { shape: 'ring',     left: '27%', top: '9%',  size: 54,  speed: 1.2,  spin: 48,  rot: 0 },
];

const SHAPES: Record<string, string> = {
  pinwheel: `<svg viewBox="0 0 120 120" fill="none"><g fill="url(#sdPetal)">
    <path d="M60 60 63.6 8.1A52 52 0 0 1 111.9 56.4Z"/>
    <path d="M60 60 111.9 63.6A52 52 0 0 1 63.6 111.9Z"/>
    <path d="M60 60 56.4 111.9A52 52 0 0 1 8.1 63.6Z"/>
    <path d="M60 60 8.1 56.4A52 52 0 0 1 56.4 8.1Z"/></g></svg>`,
  asterisk: `<svg viewBox="0 0 100 100" fill="none">
    <path d="M50 8v84M13.6 29l72.8 42M86.4 29l-72.8 42"
      stroke="url(#sdCoral)" stroke-width="16" stroke-linecap="round"/></svg>`,
  crescent: `<svg viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="33" stroke="url(#sdPink)" stroke-width="26"
      stroke-linecap="round" stroke-dasharray="152 208" transform="rotate(125 50 50)"/></svg>`,
  arch: `<svg viewBox="0 0 100 100">
    <path d="M6 96V50a44 44 0 0 1 88 0v46H66V50a22 22 0 0 0-44 0v46z" fill="url(#sdBlue)"/></svg>`,
  diamond: `<svg viewBox="0 0 100 100">
    <rect x="27" y="27" width="46" height="46" rx="11" fill="url(#sdBrand)" transform="rotate(45 50 50)"/></svg>`,
  squiggle: `<svg viewBox="0 0 100 120" fill="none">
    <path d="M24 108c42-6 18-30 54-38-40-6-14-30-52-38" stroke="url(#sdViolet)"
      stroke-width="20" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
  ring: `<svg viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="34" stroke="url(#sdBrand)" stroke-width="17"/></svg>`,
};
---
<div id="streak">
  <div class="streak-pin">
    <div class="s-decor" aria-hidden="true">
      {DECOR.map((d) => (
        <span
          class="deco"
          data-speed={d.speed}
          data-spin={d.spin}
          style={`left:${d.left};top:${d.top};--size:${d.size}px`}
        >
          <span class="deco-in" style={`--rot:${d.rot}deg`}>
            <Fragment set:html={SHAPES[d.shape]} />
          </span>
        </span>
      ))}
    </div>

    <div class="s-head">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 data-split>{s.headline}<br /><em class="grad">{s.headlineAccent}</em></h2>
      <p class="lede">{s.lede}</p>
    </div>

    <div class="s-body">
      <!-- Each square is a day. Scroll advances the calendar; the day
           at data-miss stays dark and resets the counter. -->
      <div class="grid" id="streak-grid" aria-hidden="true">
        {days.map((d) => (
          <span class:list={['d', d === s.missedDay && 'miss']} data-i={d}>
            {d === s.missedDay ? '!' : ''}
          </span>
        ))}
      </div>

      <div class="readout">
        <div class="ro">
          <div class="ro-v"><span id="streak-count">0</span><span class="ro-u">days</span></div>
          <div class="ro-l">{s.runningLabel} streak</div>
        </div>
        <div class="ro">
          <div class="ro-v grad"><span id="streak-score">0</span><span class="ro-u">/100</span></div>
          <div class="ro-l">{s.scoreLabel}</div>
        </div>
        <p class="s-note" id="streak-note" data-label={s.missedLabel}>&nbsp;</p>
      </div>
    </div>
  </div>

  <svg class="s-sprite" aria-hidden="true" focusable="false">
    <defs>
      {/* The pinwheel is four separate blades, so its ramp has to run over
          the whole 120 box — the default per-element units would restart
          it on every blade and show the seams. */}
      <linearGradient id="sdPetal" gradientUnits="userSpaceOnUse" x1="10" y1="0" x2="110" y2="120">
        <stop offset="0%" stop-color="#FF7A00"/>
        <stop offset="55%" stop-color="#F79BB4"/>
        <stop offset="100%" stop-color="#E0A6FF"/>
      </linearGradient>
      <linearGradient id="sdCoral" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#FFCBA6"/><stop offset="100%" stop-color="#FF5F5F"/>
      </linearGradient>
      <linearGradient id="sdPink" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#E0409E"/><stop offset="100%" stop-color="#FFC7EF"/>
      </linearGradient>
      <linearGradient id="sdBlue" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#4FD8F5"/>
        <stop offset="55%" stop-color="#C9A8FF"/>
        <stop offset="100%" stop-color="#FFB1E6"/>
      </linearGradient>
      <linearGradient id="sdViolet" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#7B5CF0"/><stop offset="100%" stop-color="#F09BD8"/>
      </linearGradient>
      <linearGradient id="sdBrand" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#7B68E8"/><stop offset="100%" stop-color="#C9A17C"/>
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  #streak{position:relative;height:340vh;z-index:2;}
  .streak-pin{
    position:sticky;top:0;height:100vh;display:flex;flex-direction:column;
    align-items:center;justify-content:center;gap:var(--space-7);
    overflow:hidden;padding:0 var(--space-4);text-align:center;
  }
  .s-head{max-width:640px;}
  .s-head h2{font-size:clamp(26px,3.8vw,44px);}
  .s-head .lede{margin:var(--space-4) auto 0;font-size:15px;}

  /* Flat tinted panel, same as the step cards — the tint alone separates
     it from the page, so the shapes drifting behind stay readable. */
  .s-body{
    position:relative;z-index:2;
    display:flex;align-items:center;gap:clamp(40px, 5vw, 72px);flex-wrap:wrap;justify-content:center;
    background:#17151F;border-radius:32px;
    padding:clamp(32px, 6vw, 56px) clamp(32px, 6vw, 64px);
    margin:0 auto;
  }

  /* ── Drifting shapes ───────────────────────────────────────────
     .deco carries the scroll parallax written from scroll.ts;
     .deco-in carries the entry pop and the idle float, so the two
     never overwrite each other's transform. */
  .s-decor{position:absolute;inset:0;pointer-events:none;z-index:1;}
  .s-sprite{position:absolute;width:0;height:0;}
  .deco{
    position:absolute;
    width:calc(var(--size) * var(--k, 1));
    height:calc(var(--size) * var(--k, 1));
    margin:calc(var(--size) * var(--k, 1) / -2) 0 0 calc(var(--size) * var(--k, 1) / -2);
    will-change:transform;
  }
  .deco-in{
    display:block;width:100%;height:100%;transform:rotate(var(--rot));
    filter:drop-shadow(0 16px 30px rgba(0,0,0,.5));
  }
  .deco :global(svg){width:100%;height:100%;display:block;}
  .grid{
    display:grid;grid-template-columns:repeat(9,1fr);gap:8px;
    width:min(88vw,352px);
  }
  .d{
    aspect-ratio:1;border-radius:8px;background:#101014;
    border:1px solid #23222A;display:grid;place-items:center;
    font-size:10px;font-weight:var(--fw-black);color:transparent;
    transition:background .18s ease,border-color .18s ease,transform .18s cubic-bezier(.2,1.4,.4,1),box-shadow .18s ease;
  }
  /* Filled by the scroll engine, which sets .on / .burn per square. */
  .d:global(.on){
    background:var(--app-grad);border-color:transparent;transform:scale(1.06);
    box-shadow: 0 4px 12px rgba(123, 104, 232, 0.3);
  }
  .d:global(.burn){
    background:#1A1216;border-color:rgba(255,75,75,.45);color:#FF6B6B;transform:none;
    box-shadow: 0 4px 12px rgba(255, 75, 75, 0.2);
  }

  .readout{text-align:left;min-width:170px;}
  .ro{margin-bottom:var(--space-5);}
  .ro-v{
    font-size:clamp(38px,5vw,58px);font-weight:var(--fw-black);line-height:1;
    font-variant-numeric:tabular-nums;
  }
  .ro-v.grad{background:var(--app-grad-h);-webkit-background-clip:text;background-clip:text;color:transparent;}
  .ro-u{font-size:.34em;color:var(--app-text-3);margin-left:6px;-webkit-text-fill-color:var(--app-text-3);}
  .ro-l{
    font-size:11px;font-weight:var(--fw-black);letter-spacing:1.4px;
    text-transform:uppercase;color:var(--app-text-3);margin-top:6px;
  }
  .s-note{
    font-size:13px;font-weight:var(--fw-extrabold);color:#FF6B6B;
    min-height:18px;opacity:0;transition:opacity .2s;
  }
  .s-note:global(.on){opacity:1;}

  @media (max-width:760px){
    #streak{height:300vh;}
    .streak-pin{gap:var(--space-6);}
    /* Shrink the shapes rather than drop them — on a narrow screen the
       card already fills the middle and they only read at the edges. */
    .deco{--k:.55;}
    .s-body{gap:var(--space-6);}
    .grid{grid-template-columns:repeat(9,1fr);width:min(84vw,300px);gap:5px;}
    .readout{text-align:center;display:flex;gap:var(--space-7);align-items:flex-start;justify-content:center;}
    .ro{margin-bottom:0;}
    .s-note{width:100%;}
  }
  @media (prefers-reduced-motion:reduce){
    #streak{height:auto;}
    .streak-pin{position:static;height:auto;padding:80px var(--space-4);}
    .s-decor{display:none;}
    .d{background:var(--app-grad);border-color:transparent;}
    .d.miss{background:#1A1216;border-color:rgba(255,75,75,.45);color:#FF6B6B;}
  }
</style>
