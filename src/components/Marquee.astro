---
import { marquee } from '../data/site';
const doubled = [...marquee, ...marquee]; // duplicated so the loop is seamless
---
<div class="marq" aria-hidden="true">
  <div class="marq-in">{doubled.map((t) => <span>{t}</span>)}</div>
</div>

<style>
  .marq{
    overflow:hidden;padding:var(--space-5) 0;
    border-bottom:2px solid var(--app-card-border);position:relative;z-index:2;
  }
  .marq-in{display:flex;width:max-content;animation:marq 30s linear infinite;}
  .marq-in span{
    font-size:13px;letter-spacing:2px;text-transform:uppercase;color:var(--app-text-3);
    font-weight:var(--fw-black);display:flex;align-items:center;gap:var(--space-7);
    white-space:nowrap;padding-right:var(--space-7);
  }
  .marq-in span::after{
    content:"";width:6px;height:6px;border-radius:var(--radius-circle);
    background:var(--app-purple);opacity:.5;
  }
  @keyframes marq{to{transform:translateX(-50%)}}
</style>
