---
import { cta } from '../data/site';
import WaitlistForm from './WaitlistForm.astro';

/* Shapes inside the card's own footprint, not the page gutters. The
   card carries no fill, so they read straight through it — and the
   gutters are the first thing to vanish as the viewport narrows, which
   is what left them invisible when they lived out there.

   They sit in the dead space either side of the centred form column,
   so nothing lands behind the copy or the fields.

   Same .deco / .deco-in contract the score and streak sections use, so
   initDecor() gives them the entrance pop, the idle float and the
   scroll parallax without knowing anything about this section. */
const DECOR = [
  /* The top two sit lower than the corners they'd naturally take: the
     parallax lifts everything, and starting them at the very top just
     means they're clipped away for most of the scroll. */
  { shape: 'pill',      left: '19%', top: '15%', size: 46,  speed: 1.3,  spin: 34,  rot: 18 },
  { shape: 'diamond',   left: '88%', top: '23%', size: 54,  speed: 1.45, spin: 70,  rot: 0 },
  { shape: 'ring',      left: '11%', top: '30%', size: 88,  speed: 1.2,  spin: 42,  rot: 0 },
  { shape: 'triangle',  left: '93%', top: '42%', size: 42,  speed: 0.95, spin: -52, rot: 0 },
  { shape: 'clover',    left: '89%', top: '64%', size: 110, speed: 0.75, spin: -26, rot: -12 },
  { shape: 'hourglass', left: '9%',  top: '68%', size: 60,  speed: 1.05, spin: -38, rot: 8 },
  { shape: 'asterisk',  left: '86%', top: '89%', size: 46,  speed: 1.15, spin: 60,  rot: 0 },
  /* Hard into the bottom-left corner. The avatars row underneath the form
     is centred and keeps its width as the card narrows, so anything much
     closer to the middle than this ends up sitting on top of it.

     The arc only occupies the lower half of its box, so this sits higher
     than it looks — it rises out of the card's bottom edge. */
  { shape: 'dome',      left: '6%',  top: '92%', size: 130, speed: 0.6,  spin: 6,   rot: 0 },
];

const SHAPES: Record<string, string> = {
  ring: `<svg viewBox="0 0 100 100" fill="none">
    <circle cx="50" cy="50" r="32" stroke="url(#ctCyan)" stroke-width="18"/></svg>`,
  clover: `<svg viewBox="0 0 100 100"><g fill="url(#ctPink)">
    <circle cx="34" cy="34" r="24"/><circle cx="66" cy="34" r="24"/>
    <circle cx="34" cy="66" r="24"/><circle cx="66" cy="66" r="24"/></g></svg>`,
  diamond: `<svg viewBox="0 0 100 100">
    <rect x="28" y="28" width="44" height="44" rx="10" fill="url(#ctAmber)"
      transform="rotate(45 50 50)"/></svg>`,
  hourglass: `<svg viewBox="0 0 100 100">
    <path d="M24 20h52L50 50l26 30H24l26-30z" fill="url(#ctViolet)"
      stroke="url(#ctViolet)" stroke-width="11" stroke-linejoin="round"/></svg>`,
  dome: `<svg viewBox="0 0 100 100">
    <path d="M2 96a48 48 0 0 1 96 0z" fill="url(#ctGreen)"/></svg>`,
  pill: `<svg viewBox="0 0 100 100">
    <rect x="30" y="8" width="40" height="84" rx="20" fill="url(#ctPink)"/></svg>`,
  triangle: `<svg viewBox="0 0 100 100">
    <path d="M50 18 86 80H14z" fill="url(#ctCyan)" stroke="url(#ctCyan)"
      stroke-width="12" stroke-linejoin="round"/></svg>`,
  asterisk: `<svg viewBox="0 0 100 100" fill="none">
    <path d="M50 12v76M17 31l66 38M83 31l-66 38" stroke="url(#ctAmber)"
      stroke-width="15" stroke-linecap="round"/></svg>`,
};
---
<section id="join-sec">
  <div class="wrap">
    <div class="cta rv" id="join">
      <div class="cta-decor" aria-hidden="true">
        {DECOR.map((d) => (
          <span class="deco" data-speed={d.speed} data-spin={d.spin}
            style={`left:${d.left};top:${d.top};--size:${d.size}px`}>
            <span class="deco-in" style={`--rot:${d.rot}deg`}>
              <Fragment set:html={SHAPES[d.shape]} />
            </span>
          </span>
        ))}
      </div>

      <p class="eyebrow">{cta.eyebrow}</p>
      <h2 data-split>{cta.headline}<br /><em class="grad">{cta.headlineAccent}</em></h2>
      <p class="lede">{cta.lede}</p>
      <div class="form-slot"><WaitlistForm /></div>
    </div>
  </div>

  <svg class="ct-sprite" aria-hidden="true" focusable="false">
    <defs>
      {/* userSpaceOnUse over the 0–100 viewBox: the clover is four
          circles and would otherwise get four separate ramps. */}
      <linearGradient id="ctCyan" gradientUnits="userSpaceOnUse" x1="12" y1="88" x2="88" y2="12">
        <stop offset="0%" stop-color="#A99BF2"/><stop offset="100%" stop-color="#4FD8F5"/>
      </linearGradient>
      <linearGradient id="ctPink" gradientUnits="userSpaceOnUse" x1="90" y1="10" x2="10" y2="90">
        <stop offset="0%" stop-color="#E8489E"/><stop offset="100%" stop-color="#FFC7EF"/>
      </linearGradient>
      <linearGradient id="ctAmber" gradientUnits="userSpaceOnUse" x1="8" y1="92" x2="92" y2="8">
        <stop offset="0%" stop-color="#F2963C"/><stop offset="100%" stop-color="#FFD3A1"/>
      </linearGradient>
      <linearGradient id="ctViolet" gradientUnits="userSpaceOnUse" x1="8" y1="92" x2="92" y2="8">
        <stop offset="0%" stop-color="#7B5CF0"/><stop offset="100%" stop-color="#C9A8FF"/>
      </linearGradient>
      <linearGradient id="ctGreen" gradientUnits="userSpaceOnUse" x1="10" y1="96" x2="90" y2="40">
        <stop offset="0%" stop-color="#3FD97B"/><stop offset="100%" stop-color="#46D8E0"/>
      </linearGradient>
    </defs>
  </svg>
</section>

<style>
  /* Clipped so a drifting shape never widens the page. */
  #join-sec{position:relative;z-index:2;padding:100px 0 120px;overflow:hidden;}
  #join-sec .wrap{position:relative;z-index:2;}
  .ct-sprite{position:absolute;width:0;height:0;}

  .cta-decor{position:absolute;inset:0;pointer-events:none;z-index:1;}
  .deco{
    position:absolute;
    width:calc(var(--size) * var(--k, 1));
    height:calc(var(--size) * var(--k, 1));
    margin:calc(var(--size) * var(--k, 1) / -2) 0 0 calc(var(--size) * var(--k, 1) / -2);
    will-change:transform;
  }
  /* No drop-shadow here, unlike the other decor sections: with the card
     unfilled there's no surface to cast onto, and a blurred shadow on a
     near-black page just leaves a grey smudge around each shape. */
  .deco-in{
    display:block;width:100%;height:100%;transform:rotate(var(--rot));
  }
  .deco :global(svg){width:100%;height:100%;display:block;}

  /* Gradient ring, no fill — the shapes sit behind this card and any
     fill hides them.

     The usual padding-box/border-box two-layer trick can't do this: it
     needs an opaque interior layer to cover the gradient. A masked
     pseudo-element punches the middle out instead, leaving the ring
     over a genuinely transparent card. */
  .cta{
    position:relative;
    border-radius:32px;padding:88px var(--space-6);text-align:center;
    /* The decor layer lives in here and the parallax drifts each shape a
       long way up as the section passes. Clipping to the card is what
       keeps them inside the ring instead of wandering over the border. */
    overflow:hidden;
  }
  /* Above the shapes — they're decoration, the form is the point. */
  .cta > :not(.cta-decor){position:relative;z-index:2;}
  .cta::before{
    content:'';position:absolute;inset:0;pointer-events:none;
    border-radius:inherit;padding:1.5px;
    background:linear-gradient(115deg,#A99BF2,#E86FB8 45%,#F2963C);
    -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite:xor;
    mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite:exclude;
  }
  .cta h2 em{font-style:normal;}
  .cta .lede{margin:var(--space-5) auto 0;}
  .form-slot{margin-top:var(--space-7);}

  @media (max-width:600px){ .cta{padding:56px var(--space-5);border-radius:24px;} }
  @media (max-width:860px){
    /* The gutters the shapes live in are gone once the card is nearly
       full-bleed — they'd sit behind it and never show. */
    .cta-decor{display:none;}
  }
  @media (prefers-reduced-motion:reduce){
    .cta-decor{display:none;}
  }
</style>
