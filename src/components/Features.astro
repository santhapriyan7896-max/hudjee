---
import { features } from '../data/site';
import Icon from './Icon.astro';
---
<div id="feat">
  <div class="feat-pin">
    <div class="feat-head rv">
      <p class="eyebrow">{features.eyebrow}</p>
      <h2 data-split>{features.headline}<br /><em class="grad">{features.headlineAccent}</em></h2>
    </div>

    <div class="feat-track" id="ftrack">
      {features.cards.map((c) => (
        <div class="fcard">
          <div class="ico"><Icon name={c.icon} size={26} color={c.color} /></div>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
          <span class:list={['tag', c.tagClass]}>{c.tag}</span>
        </div>
      ))}
    </div>

    <div class="feat-bar"><div class="t"><i id="fbar"></i></div></div>
  </div>
</div>

<style>
  #feat{position:relative;height:460vh;z-index:2;}
  .feat-pin{
    position:sticky;top:0;height:100vh;display:flex;flex-direction:column;
    justify-content:center;overflow:hidden;
  }
  .feat-head{max-width:var(--max);margin:0 auto var(--space-8);padding:0 var(--space-4);width:100%;}
  .feat-track{
    display:flex;gap:var(--space-4);
    padding:0 max(16px,calc((100vw - var(--max)) / 2));will-change:transform;
  }
  .fcard{
    flex:0 0 336px;background:var(--app-card);border-radius:var(--app-r-card);
    border:1px solid var(--border-default);
    padding:var(--space-6);transition:border-color .16s,transform .16s cubic-bezier(.2,1.3,.4,1);
  }
  .fcard:hover{border-color:#33323A;}
  .fcard .ico{
    width:52px;height:52px;border-radius:var(--radius-md);background:var(--app-elevated);
    display:grid;place-items:center;margin-bottom:var(--space-5);
  }
  .fcard h3{font-size:21px;margin-bottom:var(--space-3);}
  .fcard p{color:var(--app-text-2);font-size:15px;font-weight:var(--fw-semibold);line-height:1.5;}
  .fcard .tag{display:inline-block;margin-top:var(--space-5);}
  .feat-bar{max-width:var(--max);margin:var(--space-7) auto 0;padding:0 var(--space-4);width:100%;}
  .feat-bar .t{height:8px;background:#232227;border-radius:var(--radius-pill);overflow:hidden;}
  .feat-bar .t i{
    display:block;height:100%;width:0;border-radius:var(--radius-pill);
    background:linear-gradient(90deg,var(--app-grad-start),var(--app-grad-end));
  }
  @media (max-width:960px){ #feat{height:400vh;} .fcard{flex:0 0 280px;} }
  @media (prefers-reduced-motion:reduce){
    #feat{height:auto;}
    .feat-pin{position:static;height:auto;padding:80px 0;}
    .feat-track{flex-wrap:wrap;justify-content:center;transform:none!important;}
    .feat-bar{display:none;}
  }
</style>
