---
import { hero } from '../data/site';
---
<div id="hero">
  <!-- Formulas write themselves in behind the headline as you scroll.
       SVG <text> with no fill and a gradient stroke, revealed left to
       right by a clipPath rect whose width is driven by scroll. -->
  <div class="formulas" aria-hidden="true">
    {hero.formulas.map((f, i) => (
      <svg class="formula" data-at={f.at} viewBox="0 0 620 60"
           style={`left:${f.left};top:${f.top};width:${f.size * 13}px;--rot:${f.rotate}deg`}>
        <defs>
          <linearGradient id={`fg-${i}`} x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#7B68E8"></stop>
            <stop offset="100%" stop-color="#C9A17C"></stop>
          </linearGradient>
          <clipPath id={`fc-${i}`}><rect x="0" y="0" width="0" height="60"></rect></clipPath>
        </defs>
        <text x="0" y="44" clip-path={`url(#fc-${i})`}
              fill="none" stroke={`url(#fg-${i})`} stroke-width="1.1"
              font-family="Montserrat, sans-serif" font-size="40" font-weight="500">{f.text}</text>
      </svg>
    ))}
  </div>

  <div class="hero-inner" id="hero-inner">
    <span class="hero-badge"><span class="pulse"></span>{hero.badge}</span>
    <h1 data-split>{hero.headline} <em class="grad">{hero.headlineAccent}</em></h1>
    <p class="hero-sub rv">{hero.sub}</p>
    <div class="hero-cta rv">
      <a href={hero.primaryCta.href} class="btn btn-primary">{hero.primaryCta.label}</a>
      <a href={hero.secondaryCta.href} class="btn btn-outline">{hero.secondaryCta.label}</a>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true"><div class="mouse"></div><span>Scroll</span></div>
</div>

<style>
  #hero{
    position:relative;height:100vh;min-height:620px;display:grid;place-items:center;
    text-align:center;overflow:hidden;z-index:2;
  }
  /* No blur filter here — it was the most expensive paint on the page
     and read as muddy. Rise + fade only. */
  .hero-inner{will-change:transform,opacity;padding:0 var(--space-5);position:relative;z-index:2;}
  .hero-badge{
    display:inline-flex;align-items:center;gap:var(--space-2);padding:8px 16px;
    border-radius:var(--radius-pill);background:rgba(123,104,232,.12);color:#A99BF2;
    font-size:12px;font-weight:var(--fw-black);letter-spacing:1.2px;text-transform:uppercase;
    margin-bottom:var(--space-6);
  }
  .pulse{width:8px;height:8px;border-radius:var(--radius-circle);background:var(--app-purple);animation:pulse 1.6s infinite;}
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(123,104,232,.55)}
    70%{box-shadow:0 0 0 10px rgba(123,104,232,0)}
    100%{box-shadow:0 0 0 0 rgba(123,104,232,0)}
  }
  h1{font-size:clamp(40px,7.4vw,100px);line-height:1;letter-spacing:-2.5px;}
  h1 em{font-style:normal;}
  .hero-sub{
    margin:var(--space-6) auto 0;max-width:580px;color:var(--app-text-2);
    font-size:clamp(15px,1.7vw,18px);font-weight:var(--fw-bold);line-height:1.55;
  }
  .hero-cta{margin-top:var(--space-8);display:flex;gap:var(--space-3);justify-content:center;flex-wrap:wrap;}

  .formulas{position:absolute;inset:0;pointer-events:none;z-index:1;}
  .formula{
    position:absolute;height:auto;overflow:visible;opacity:.75;
    transform:rotate(var(--rot));will-change:opacity;
  }

  .scroll-cue{
    position:absolute;bottom:28px;left:50%;transform:translateX(-50%);z-index:2;
    display:flex;flex-direction:column;align-items:center;gap:var(--space-2);
    color:var(--app-text-3);font-size:11px;letter-spacing:1.6px;
    text-transform:uppercase;font-weight:var(--fw-black);
  }
  .mouse{width:24px;height:38px;border:2px solid #3A393F;border-radius:var(--radius-pill);position:relative;}
  .mouse::after{
    content:"";position:absolute;left:50%;top:7px;width:4px;height:7px;border-radius:2px;
    background:var(--app-purple);transform:translateX(-50%);animation:wheel 1.5s infinite;
  }
  @keyframes wheel{
    0%{opacity:0;transform:translate(-50%,0)}35%{opacity:1}100%{opacity:0;transform:translate(-50%,14px)}
  }
  @media (max-width:760px){ .formula{display:none;} }
  @media (prefers-reduced-motion:reduce){
    .formula{display:none;}
  }
</style>
