---
/**
 * ────────────────────────────────────────────────────────────────
 *  Hero — the headline assembles itself on load.
 *
 *  Characters are emitted as individual spans here rather than being
 *  split at runtime, so the glyph-swap indices in data/site.ts stay
 *  exact (a runtime splitter drops spaces and shifts every index
 *  after one). The build sequence lives in scripts/scroll.ts.
 * ────────────────────────────────────────────────────────────────
 */
import { hero } from '../data/site';

/* Shapes that stand in for a letter mid-build, plus the two that stay
   on as decoration. Gradients live in the sprite at the bottom. */
const SHAPES: Record<string, string> = {
  asterisk: `<svg viewBox="0 0 100 100" fill="none">
    <path d="M50 8v84M13.6 29l72.8 42M86.4 29l-72.8 42"
      stroke="url(#hCoral)" stroke-width="17" stroke-linecap="round"/>
  </svg>`,
  bolt: `<svg viewBox="0 0 100 100" fill="none">
    <path d="M63 4H27L11 55h22l-9 41 65-56H64l12-36z" fill="url(#hGreen)"/>
  </svg>`,
  dot: `<svg viewBox="0 0 100 100">
    <rect x="30" y="30" width="40" height="40" rx="10" fill="url(#hBrand)" transform="rotate(45 50 50)"/>
  </svg>`,
  /* Four blades around the centre, with a thin cross of space left
     between them — that gap is what reads as a pinwheel rather than
     a pie chart. */
  pinwheel: `<svg viewBox="0 0 120 120" fill="none">
    <g fill="url(#hPetal)">
      <path d="M60 60 63.6 8.1A52 52 0 0 1 111.9 56.4Z"/>
      <path d="M60 60 111.9 63.6A52 52 0 0 1 63.6 111.9Z"/>
      <path d="M60 60 56.4 111.9A52 52 0 0 1 8.1 63.6Z"/>
      <path d="M60 60 8.1 56.4A52 52 0 0 1 56.4 8.1Z"/>
    </g>
  </svg>`,
  squiggle: `<svg viewBox="0 0 100 120" fill="none">
    <path d="M24 108c42-6 18-30 54-38-40-6-14-30-52-38"
      stroke="url(#hViolet)" stroke-width="21" stroke-linecap="round" stroke-linejoin="round"/>
    <path d="M28 100c30-6 14-24 44-30" stroke="#F0C9FF" stroke-opacity=".45"
      stroke-width="5" stroke-linecap="round"/>
  </svg>`,
};

const brace = `<svg viewBox="0 0 18 100" preserveAspectRatio="none" fill="none">
  <path d="M15 1C8 1 10 9 10 21c0 15-8 22-8 29s8 14 8 29c0 12-2 20 5 20"
    stroke="currentColor" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
</svg>`;
---
<div id="hero">
  <span class="hero-badge"><span class="pulse"></span>{hero.badge}</span>

  <div class="h-wrap" id="hero-inner">
    <span class="deco deco-pinwheel"><Fragment set:html={SHAPES.pinwheel} /></span>
    <span class="deco deco-squiggle"><Fragment set:html={SHAPES.squiggle} /></span>

    <h1 class="h-title">
      {/* The visible headline is emitted as one <span> per character so each
          glyph can be animated independently. That leaves crawlers and screen
          readers with a run of separate nodes and no word boundaries, so the
          real sentence is carried here and the decorative spans are hidden
          from the accessibility tree. Keep this text identical to
          hero.lines. */}
      <span class="visually-hidden">{hero.lines.join(' ')}</span>
      {hero.lines.map((text, li) => (
        <span class="h-line" aria-hidden="true">
          {[...text].map((c, ci) => {
            const swap = hero.swaps.find((s) => s.line === li && s.index === ci);
            return c === ' ' ? (
              <span class="sp"> </span>
            ) : (
              <span class="ch">
                <span class:list={['g', swap && 'held']}>{c}</span>
                {swap && <span class="stand"><Fragment set:html={SHAPES[swap.shape]} /></span>}
              </span>
            );
          })}
        </span>
      ))}
    </h1>
  </div>

  <div class="h-foot">
    <p class="h-lede">
      <span class="brace brace-l"><Fragment set:html={brace} /></span>
      {hero.lede}
      <span class="brace brace-r"><Fragment set:html={brace} /></span>
    </p>

    <div class="h-cta">
      <a href={hero.secondaryCta.href} class="h-link">{hero.secondaryCta.label}</a>
      <a href={hero.primaryCta.href} class="h-btn" data-burst>
        <span class="b-words">
          {hero.primaryCta.label.split(' ').map((w) => <span class="b-w">{w}</span>)}
        </span>

        {/* The ring stays put; the arrow inside drops out of the bottom and
            a second one takes its place from above. */}
        <span class="b-arrow" aria-hidden="true">
          <svg class="b-ring" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          <span class="b-clip">
            <svg class="b-tick" viewBox="0 0 24 24" fill="none">
              <path d="M12 6v11m0 0 4.5-4.5M12 17l-4.5-4.5" stroke="currentColor"
                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="b-tick" viewBox="0 0 24 24" fill="none">
              <path d="M12 6v11m0 0 4.5-4.5M12 17l-4.5-4.5" stroke="currentColor"
                stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </span>

        <span class="b-confetti" aria-hidden="true">
          <span class="cf"><svg viewBox="0 0 40 40"><g fill="#38B6FF"><path d="M20 20 21.2 2.7A17.3 17.3 0 0 1 37.3 18.8Z"/><path d="M20 20 37.3 21.2A17.3 17.3 0 0 1 21.2 37.3Z"/><path d="M20 20 18.8 37.3A17.3 17.3 0 0 1 2.7 21.2Z"/><path d="M20 20 2.7 18.8A17.3 17.3 0 0 1 18.8 2.7Z"/></g></svg></span>
          <span class="cf"><svg viewBox="0 0 40 40"><g fill="#FF8F00"><circle cx="20" cy="9" r="9"/><circle cx="31" cy="20" r="9"/><circle cx="20" cy="31" r="9"/><circle cx="9" cy="20" r="9"/></g></svg></span>
          <span class="cf"><svg viewBox="0 0 40 40"><rect x="7" y="7" width="26" height="26" rx="5" fill="#FFB1E6"/></svg></span>
          <span class="cf"><svg viewBox="0 0 40 40" fill="none"><path d="M20 3v34M5.3 11.5l29.4 17M34.7 11.5l-29.4 17" stroke="#0AE448" stroke-width="6" stroke-linecap="round"/></svg></span>
          <span class="cf"><svg viewBox="0 0 40 40"><circle cx="20" cy="20" r="11" fill="#A99BF2"/></svg></span>
          <span class="cf"><svg viewBox="0 0 40 40"><rect x="9" y="9" width="22" height="22" rx="4" fill="#4FD8F5" transform="rotate(45 20 20)"/></svg></span>
        </span>
      </a>
    </div>
  </div>

  <svg class="hero-sprite" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="hCoral" x1="100%" y1="0%" x2="0%" y2="100%">
        <stop offset="0%" stop-color="#FFCBA6"/><stop offset="100%" stop-color="#FF5F5F"/>
      </linearGradient>
      <linearGradient id="hGreen" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#5BFF9B"/><stop offset="100%" stop-color="#00C853"/>
      </linearGradient>
      <linearGradient id="hBrand" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#7B68E8"/><stop offset="100%" stop-color="#C9A17C"/>
      </linearGradient>
      <linearGradient id="hPetal" x1="8%" y1="0%" x2="92%" y2="100%">
        <stop offset="0%" stop-color="#FF7A00"/>
        <stop offset="55%" stop-color="#F79BB4"/>
        <stop offset="100%" stop-color="#E0A6FF"/>
      </linearGradient>
      <linearGradient id="hViolet" x1="0%" y1="100%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#7B5CF0"/>
        <stop offset="60%" stop-color="#A98BFF"/>
        <stop offset="100%" stop-color="#F09BD8"/>
      </linearGradient>
    </defs>
  </svg>
</div>

<style>
  #hero{
    --hero-ink:#F4EFE2;
    position:relative;min-height:100vh;z-index:2;
    display:flex;flex-direction:column;
    padding:132px 4vw 44px;overflow:hidden;
  }
  .hero-sprite{position:absolute;width:0;height:0;}

  .hero-badge{
    display:inline-flex;align-items:center;gap:var(--space-2);align-self:flex-start;
    padding:8px 16px;border-radius:var(--radius-pill);
    background:rgba(123,104,232,.12);color:#A99BF2;
    font-size:12px;font-weight:var(--fw-black);letter-spacing:1.2px;text-transform:uppercase;
  }
  .pulse{width:8px;height:8px;border-radius:var(--radius-circle);background:var(--app-purple);animation:pulse 1.6s infinite;}
  @keyframes pulse{
    0%{box-shadow:0 0 0 0 rgba(123,104,232,.55);}
    70%{box-shadow:0 0 0 10px rgba(123,104,232,0);}
    100%{box-shadow:0 0 0 0 rgba(123,104,232,0);}
  }

  /* ── Headline ──────────────────────────────────────────────────
     Line one flush left, line two flush right — the stagger between
     them is what gives the block its diagonal. */
  .h-wrap{flex:1;display:flex;flex-direction:column;justify-content:center;position:relative;}
  .h-title{
    font-family:var(--font-display);font-weight:500;
    font-size:clamp(56px,15vw,238px);line-height:.94;letter-spacing:-.035em;
    color:var(--hero-ink);position:relative;z-index:2;
  }
  .h-line{display:block;white-space:nowrap;}
  .h-line:last-child{text-align:right;}
  .sp{display:inline-block;width:.24em;}

  .ch{display:inline-block;position:relative;will-change:transform;}
  .g{display:inline-block;}
  /* Hidden only while its stand-in shape is holding the slot. */
  .g.held{opacity:0;}

  .stand{
    position:absolute;left:50%;top:50%;
    width:.92em;height:.92em;transform:translate(-50%,-52%);
    pointer-events:none;
  }
  .stand :global(svg){width:100%;height:100%;display:block;}

  /* ── Decoration that stays on ──────────────────────────────── */
  .deco{position:absolute;display:block;z-index:1;filter:drop-shadow(0 18px 34px rgba(0,0,0,.5));}
  .deco :global(svg){width:100%;height:100%;display:block;}
  .deco-pinwheel{left:14%;top:6%;width:clamp(64px,9vw,132px);height:clamp(64px,9vw,132px);}
  .deco-squiggle{
    left:60%;bottom:2%;z-index:3;
    width:clamp(46px,5.6vw,84px);height:clamp(56px,6.7vw,100px);
  }

  /* ── Foot row ──────────────────────────────────────────────── */
  .h-foot{
    display:flex;align-items:flex-end;justify-content:space-between;
    gap:var(--space-6);flex-wrap:wrap;position:relative;z-index:4;
  }
  .h-lede{
    position:relative;padding:4px 38px;max-width:460px;
    color:var(--hero-ink);font-size:clamp(18px,2vw,24px);
    font-weight:var(--fw-medium);line-height:1.35;
  }
  .brace{position:absolute;top:-6px;bottom:-6px;width:24px;color:var(--hero-ink);}
  .brace :global(svg){width:100%;height:100%;display:block;}
  .brace-l{left:0;}
  .brace-r{right:0;transform:scaleX(-1);}

  .h-cta{display:flex;align-items:center;gap:var(--space-5);}
  .h-link{
    color:var(--app-text-2);font-size:14px;font-weight:var(--fw-extrabold);
    border-bottom:1px solid var(--app-card-border);padding-bottom:2px;transition:color .18s,border-color .18s;
  }
  .h-link:hover{color:var(--hero-ink);border-color:var(--hero-ink);}
  /* overflow stays visible so the confetti can leave the pill. */
  .h-btn{
    position:relative;
    display:inline-flex;align-items:center;gap:12px;white-space:nowrap;
    padding:15px 26px;border-radius:var(--radius-pill);
    border:1.5px solid #2FCB63;color:var(--hero-ink);
    font-family:var(--font-display);font-weight:var(--fw-extrabold);font-size:16px;
    transition:background .18s;
  }
  .h-btn:hover{background:rgba(47,203,99,.12);}

  .b-words{display:inline-flex;gap:.34em;}
  .b-w{display:inline-block;will-change:transform;}

  /* Ring and arrow are separate layers: the ring holds still while the
     clipped strip behind it swaps one arrow for the next. */
  .b-arrow{position:relative;display:block;width:20px;height:20px;}
  .b-ring{position:absolute;inset:0;width:100%;height:100%;}
  .b-clip{position:absolute;inset:0;overflow:hidden;border-radius:var(--radius-circle);}
  .b-tick{position:absolute;inset:0;width:100%;height:100%;}
  .b-tick:nth-child(2){transform:translateY(-100%);}

  /* Launch point — bottom-centre of the pill, behind it. */
  .b-confetti{position:absolute;left:50%;top:52%;width:0;height:0;z-index:-1;}
  .cf{position:absolute;left:0;top:0;width:22px;height:22px;margin:-11px 0 0 -11px;opacity:0;}
  .cf svg{width:100%;height:100%;display:block;}
  .cf:nth-child(2){width:17px;height:17px;margin:-8.5px 0 0 -8.5px;}
  .cf:nth-child(3){width:14px;height:14px;margin:-7px 0 0 -7px;}
  .cf:nth-child(4){width:19px;height:19px;margin:-9.5px 0 0 -9.5px;}
  .cf:nth-child(5){width:12px;height:12px;margin:-6px 0 0 -6px;}
  .cf:nth-child(6){width:15px;height:15px;margin:-7.5px 0 0 -7.5px;}

  /* Hidden until the build runs. Undone below when motion is reduced. */
  .h-title,.deco,.hero-badge,.h-foot{opacity:0;}

  @media (max-width:900px){
    #hero{padding:118px var(--space-5) 36px;}
    .deco-pinwheel{left:auto;right:4%;top:4%;}
    .deco-squiggle{left:auto;right:6%;bottom:auto;top:64%;}
    .h-foot{align-items:flex-start;flex-direction:column;}
    .h-cta{width:100%;justify-content:space-between;}
  }

  @media (prefers-reduced-motion:reduce){
    .h-title,.deco,.hero-badge,.h-foot{opacity:1;}
    .g.held{opacity:1;}
    .stand{display:none;}
    .pulse{animation:none;}
  }
</style>
