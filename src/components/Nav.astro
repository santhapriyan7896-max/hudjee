---
import { nav } from '../data/site';
---
<header class="nav" id="main-nav">
  <!-- The Green Announcement Banner -->
  <a href="#waitlist" class="nav-banner">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
      <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
    </svg>
    <span>HudJee is launching soon! <u>Pre-register now for early access.</u></span>
  </a>

  <!-- The Main Navbar -->
  <div class="wrap nav-in">
    <div class="nav-left">
      <a class="brand" href="#top" aria-label="HudJee — home">
        <img src="/logo.png" alt="HudJee" class="brand-img" />
      </a>
      <nav class="nav-links" aria-label="Primary">
        {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
    
    <div class="nav-right">
      <a href="#waitlist" class="nav-login">Login/Create Account</a>
      <a href={nav.cta.href} class="btn-nav-outline">{nav.cta.label}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 900;
    background: #111111;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1);
  }
  
  .nav:global(.hide) {
    transform: translateY(-100%);
  }

  /* Banner Styles */
  .nav-banner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #0AE448; /* GSAP Green */
    color: #0E100F; /* Dark text */
    padding: 10px 20px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: background-color 0.2s, height 0.3s, padding 0.3s, opacity 0.2s;
    height: 40px;
    overflow: hidden;
  }
  
  .nav:global(.stuck) .nav-banner {
    height: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
    pointer-events: none;
  }
  
  .nav-banner:hover {
    background-color: #0bd143; /* slightly darker on hover */
  }

  .nav-banner u {
    text-decoration-thickness: 1.5px;
    text-underline-offset: 2px;
  }

  /* Nav Inner */
  .nav-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
    max-width: 1400px; 
    margin: 0 auto;
    padding: 0 var(--space-5);
  }

  .nav-left, .nav-right {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  /* Brand / Logo */
  .brand {
    text-decoration: none;
    display: flex;
    align-items: center;
  }
  
  .brand-img {
    height: 28px; /* Slightly smaller to match GSAP header proportion */
    width: auto;
    object-fit: contain;
  }

  /* Links */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links a, .nav-login {
    color: #c4c4c4;
    font-size: 14px;
    font-weight: 600;
    font-family: var(--font-display);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover, .nav-login:hover {
    color: #ffffff;
  }
  
  .nav-login {
    margin-right: 8px;
  }

  /* Outline CTA Button matching GSAP */
  .btn-nav-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 22px;
    border-radius: 50px;
    border: 1px solid #F4F4EB;
    color: #F4F4EB;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s;
  }

  .btn-nav-outline:hover {
    background: #F4F4EB;
    color: #0E100F;
  }

  @media (max-width: 960px) {
    .nav-links { display: none; }
    .nav-in { height: 60px; gap: 16px; }
    .nav-left, .nav-right { gap: 16px; }
    .nav-login { display: none; }
  }
</style>
