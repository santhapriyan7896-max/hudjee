---
/** Lucide-style line icons: 2px stroke, rounded caps — per the DS icon spec. */
interface Props { name: string; size?: number; color?: string; }
const { name, size = 24, color = '#7B68E8' } = Astro.props;

const paths: Record<string, string> = {
  bars:   '<path d="M12 20V10M18 20V4M6 20v-4"/>',
  check:  '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="M22 4L12 14.01l-3-3"/>',
  trophy: '<path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M6 4h12v5a6 6 0 0 1-12 0V4zM9 20h6M12 15v5"/>',
  brain:  '<path d="M12 2a7 7 0 0 0-7 7c0 2.4 1.2 3.9 2.2 5.1.6.8 1.3 1.6 1.3 2.4V18h7v-1.5c0-.8.7-1.6 1.3-2.4C17.8 12.9 19 11.4 19 9a7 7 0 0 0-7-7z"/><path d="M9 21h6"/>',
  file:   '<path d="M4 19V5a2 2 0 0 1 2-2h9l5 5v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><path d="M14 3v5h5M8 13h8M8 17h5"/>',
  flame:  '<path d="M12 22c4-2 6-5 6-9 0-3-2-5-3-7-1.5 2-3 2.5-3 5 0-2-1-3.5-2-4.5C8 9 6 11 6 13c0 4 2 7 6 9z"/>',
  users:  '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',
  star:   '<path d="M12 2l2.4 7.4H22l-6 4.4 2.3 7.2-6.3-4.6-6.3 4.6L7.9 13.8 2 9.4h7.6z"/>',
  bell:   '<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/>',
  target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/>',
  clock:  '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke={color}
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
     set:html={paths[name] ?? ''} />
