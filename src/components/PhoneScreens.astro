---
import Icon from './Icon.astro';
/** The four in-device screens. Screen 3 is a faithful rebuild of the
 *  shipped Home dashboard — same cards, same order, same gradient
 *  ring on the active day and the primary CTA. */
const days = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
---
<!-- 0 · session setup -->
<div class="scr-view on" data-view="0">
  <div class="scr-top"><span>Session setup</span><span class="flame">🔥 41</span></div>
  <div class="tagrow">
    <span class="tag grad-ring">Physics</span>
    <span class="tag purple">Adaptive</span>
    <span class="tag amber">PYQ only</span>
  </div>
  <div class="card-tile mb"><div class="c-lbl">Chapter</div><div class="c-val">Rotational Motion</div></div>
  <div class="two mb">
    <div class="card-tile"><div class="c-lbl">Level</div><div class="c-val">Hard</div></div>
    <div class="card-tile"><div class="c-lbl">Format</div><div class="c-val">Mixed</div></div>
  </div>
  <div class="card-tile mb">
    <div class="c-lbl">Daily target</div><div class="c-val">20 questions</div>
    <div class="pbar"><i style="width:0"></i></div>
  </div>
  <div class="card-tile mb row-between">
    <span class="w-800">Mastery this week</span><span class="big-grad">82%</span>
  </div>
  <div class="cta-ring">Start practising →</div>
</div>

<!-- 1 · practice -->
<div class="scr-view" data-view="1">
  <div class="scr-top"><span>Q 12 / 20</span><span class="grad">01:48</span></div>
  <div class="pbar no-mt mb-lg"><i style="width:60%"></i></div>
  <p class="qstem">
    A uniform disc of mass M rolls without slipping on a horizontal surface.
    Find the ratio of its rotational kinetic energy to its total kinetic energy.
  </p>
  <div class="qbody">
    <div class="qopts">
      <div class="opt"><span class="k">A.</span><span>1 / 2</span></div>
      <div class="opt correct"><span class="k">B.</span><span>1 / 3</span></div>
      <div class="opt"><span class="k">C.</span><span>2 / 5</span></div>
      <div class="opt"><span class="k">D.</span><span>2 / 7</span></div>
    </div>
    <div class="mastery"><i style="height:64%"></i></div>
  </div>
</div>

<!-- 2 · engine -->
<div class="scr-view" data-view="2">
  <div class="scr-top"><span>Computing · 04:45 AM</span><span class="grad">Adaptive</span></div>
  {[
    ['Accuracy · 25%','76%'],['Speed · 15%','64%'],['Volume · 15%','88%'],
    ['Difficulty · 15%','71%'],['Consistency · 15%','94%'],['Focus · 10%','58%'],
    ['Target hit · 5%','80%'],
  ].map(([label,w]) => (
    <div class="card-tile mb"><div class="c-lbl">{label}</div><div class="pbar"><i style={`width:${w}`}></i></div></div>
  ))}
</div>

<!-- 3 · the dashboard -->
<div class="scr-view dash" data-view="3">
  <div class="dash-top">
    <img src="/assets/hudjee-logo.png" alt="HudJee" class="dash-logo" />
    <div class="dash-bell"><Icon name="bell" size={13} color="#75787F" /></div>
  </div>

  <h4 class="greet">Good evening</h4>
  <p class="greet-sub">Ready for today's practice?</p>

  <div class="card mb">
    <div class="row-between">
      <span class="card-h">Daily Goal</span>
      <span class="goal-meta">◎ <b>18</b>/20 &nbsp; ◷ <b>26</b>/30 ›</span>
    </div>
    <div class="days">
      {days.map((d,i) => (
        <div class:list={['day', i === 6 && 'active']}>
          <span class="dot">{i === 6 ? '' : '!'}</span>
          <span class="dl">{d}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="card mb">
    <div class="ready">
      <div class="ready-l">
        <div class="card-h lg">Readiness Score</div>
        <p class="ready-sub">Where you stand today</p>
      </div>
      <div class="gauge">
        <svg width="92" height="92" viewBox="0 0 92 92" aria-hidden="true">
          <circle cx="46" cy="46" r="39" fill="none" stroke="#232227" stroke-width="7"></circle>
          <circle id="ring" cx="46" cy="46" r="39" fill="none" stroke="url(#gg)" stroke-width="7"
                  stroke-linecap="round" stroke-dasharray="245" stroke-dashoffset="245"></circle>
          <defs>
            <linearGradient id="gg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#7B68E8"></stop>
              <stop offset="100%" stop-color="#C9A17C"></stop>
            </linearGradient>
          </defs>
        </svg>
        <div class="gauge-val"><span class="num" id="score-num">0</span><span class="den">/100</span></div>
      </div>
    </div>
    <div class="cta-ring sm">Start practising →</div>
  </div>

  <div class="tiles">
    <div class="card-tile tile"><div class="ico-chip"><Icon name="flame" size={13} color="#ABABB3" /></div>
      <div class="tv"><b>41</b> days</div><div class="tl">Streak</div></div>
    <div class="card-tile tile"><div class="ico-chip"><Icon name="target" size={13} color="#ABABB3" /></div>
      <div class="tv"><b>18</b> Qs</div><div class="tl">Solved today</div></div>
    <div class="card-tile tile"><div class="ico-chip"><Icon name="clock" size={13} color="#ABABB3" /></div>
      <div class="tv"><b>26</b> min</div><div class="tl">Time today</div></div>
  </div>
</div>

<style>
  .scr-view{
    position:absolute;inset:0;padding:22px 13px 12px;opacity:0;transform:translateY(10px);
    transition:opacity .26s,transform .32s cubic-bezier(.2,1.25,.4,1);overflow:hidden;
  }
  .scr-view:global(.on){opacity:1;transform:none;}
  .scr-top{
    display:flex;justify-content:space-between;align-items:center;font-size:11px;
    color:var(--app-text-3);font-weight:var(--fw-bold);margin-bottom:var(--space-3);
  }
  .flame{color:var(--app-amber);font-weight:var(--fw-black);}
  .mb{margin-bottom:9px;}
  .mb-lg{margin-bottom:14px;}
  .no-mt{margin-top:0;}
  .two{display:grid;grid-template-columns:1fr 1fr;gap:9px;}
  .tagrow{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:9px;}
  .row-between{display:flex;justify-content:space-between;align-items:center;}
  .w-800{font-size:13px;font-weight:var(--fw-extrabold);}
  .big-grad{
    font-size:19px;font-weight:var(--fw-black);
    background:var(--app-grad-h);-webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .cta-ring{
    display:block;text-align:center;font-weight:var(--fw-extrabold);font-size:14px;
    padding:12px;border-radius:var(--app-r-btn);border:2px solid transparent;
    background:linear-gradient(var(--app-card),var(--app-card)) padding-box, var(--app-grad) border-box;
  }
  .cta-ring.sm{font-size:13px;padding:10px;margin-top:14px;}

  /* Question content — Montserrat only, per the DS */
  .qstem{font-family:var(--font-question);color:#E5E5E5;font-size:13.5px;line-height:1.45;margin-bottom:14px;}
  .qbody{display:flex;align-items:flex-end;gap:11px;}
  .qopts{flex:1;display:flex;flex-direction:column;gap:9px;}
  .opt{
    display:flex;align-items:center;gap:8px;padding:12px 13px;border-radius:var(--app-r-tile);
    border:1px solid var(--app-card-border);background:var(--app-card);color:#CCC;
    font-family:var(--font-question);font-size:12.5px;font-weight:500;
  }
  .opt .k{color:#75787F;width:17px;flex-shrink:0;}
  .opt.correct{border-color:rgba(52,211,153,.5);background:rgba(52,211,153,.08);}
  .opt.correct .k{color:var(--app-correct);}
  .mastery{
    width:28px;height:180px;border-radius:10px;border:1px solid var(--app-card-border);
    display:flex;flex-direction:column-reverse;overflow:hidden;flex-shrink:0;
  }
  .mastery i{width:100%;background:linear-gradient(180deg,var(--app-amber),var(--app-purple));}

  /* ── Dashboard screen ── */
  .dash{padding:20px 13px 12px;}
  .dash-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;}
  .dash-logo{height:15px;width:auto;}
  .dash-bell{
    width:26px;height:26px;border-radius:var(--radius-circle);
    background:var(--app-elevated);display:grid;place-items:center;
  }
  .greet{font-size:23px;font-weight:var(--fw-black);letter-spacing:-.5px;}
  .greet-sub{color:var(--app-text-2);font-size:12px;font-weight:var(--fw-semibold);margin:2px 0 14px;}
  .card{padding:13px;border-radius:var(--app-r-card);}
  .card-h{font-size:14px;font-weight:var(--fw-black);}
  .card-h.lg{font-size:16px;}
  .goal-meta{font-size:10px;color:var(--app-text-3);font-weight:var(--fw-bold);}
  .goal-meta :global(b){color:#fff;}

  .days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;margin-top:11px;}
  .day{
    background:var(--app-elevated);border-radius:var(--app-r-chip);
    padding:8px 0 6px;text-align:center;border:1px solid transparent;
  }
  .day.active{
    background:linear-gradient(var(--app-card),var(--app-card)) padding-box, var(--app-grad) border-box;
  }
  .day .dot{display:block;font-size:11px;color:var(--app-text-3);height:13px;font-weight:var(--fw-black);}
  .day.active .dot{
    width:9px;height:9px;margin:2px auto;border-radius:var(--radius-circle);
    border:1.5px solid var(--app-text-3);
  }
  .day .dl{font-size:8.5px;color:var(--app-text-3);font-weight:var(--fw-bold);}

  .ready{display:flex;justify-content:space-between;align-items:center;gap:10px;}
  .ready-sub{color:var(--app-text-2);font-size:11px;font-weight:var(--fw-semibold);margin-top:4px;}
  .gauge{position:relative;width:92px;height:92px;flex-shrink:0;}
  .gauge svg{transform:rotate(-90deg);}
  .gauge-val{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  .gauge-val .num{font-size:27px;font-weight:var(--fw-black);line-height:1;color:#fff;}
  .gauge-val .den{font-size:9px;color:var(--app-text-3);font-weight:var(--fw-bold);margin-top:1px;}

  .tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
  .tile{padding:11px 10px;}
  .tile .tv{font-size:15px;font-weight:var(--fw-bold);color:var(--app-text-3);margin-top:10px;}
  .tile .tv :global(b){font-size:18px;font-weight:var(--fw-black);color:#fff;}
  .tile .tl{font-size:9px;color:var(--app-text-3);font-weight:var(--fw-bold);margin-top:2px;}

  /* The phone shrinks 302→252px on mobile but its contents don't,
     so the dashboard is tightened to stay inside the 496px screen. */
  @media (max-width:600px){
    .dash{padding:16px 11px 10px;}
    .dash-top{margin-bottom:12px;}
    .greet{font-size:20px;}
    .greet-sub{font-size:11px;margin-bottom:11px;}
    .card{padding:11px;}
    .gauge{width:78px;height:78px;}
    .gauge svg{width:78px;height:78px;}
    .gauge-val .num{font-size:23px;}
    .ico-chip{width:28px;height:28px;}
    .tile{padding:9px 8px;}
    .tile .tv{margin-top:7px;font-size:13px;}
    .tile .tv :global(b){font-size:16px;}
    .cta-ring.sm{margin-top:11px;padding:9px;}
  }

  @media (prefers-reduced-motion:reduce){
    .scr-view{position:static;opacity:1;transform:none;}
    .scr-view:not([data-view="3"]){display:none;}
  }
</style>
